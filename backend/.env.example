# Providers
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here          # keys beginning "gsk_" are Groq keys
XAI_API_KEY=                              # optional; only for live Grok Realtime voice

# Models
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=
TTS_PROVIDER=edge                         # edge | groq | elevenlabs
ELEVENLABS_API_KEY=

# App
DATABASE_URL=sqlite:///./studysphere.db
JWT_SECRET=studysphere_jwt_secret_dev_key_2026_super_secure_32char
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=100
